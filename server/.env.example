PORT=4000
# Set to enable real AI seller agents. Without it the server uses simulated bids.
ANTHROPIC_API_KEY=
# Optional: model used by the agents
AGENT_MODEL=claude-haiku-5-5

# NEAR testnet (all three required to record auctions on-chain; leave blank to disable)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_CONTRACT_ID=

# --- Spending protection (defaults shown; each AI auction makes about 16 AI calls) ---
# MAX_AUCTIONS_PER_IP_PER_HOUR=6
# MAX_AUCTIONS_PER_DAY=40
# MAX_CONCURRENT_AUCTIONS=2
# MAX_ROUNDS=2
# Browser origins allowed to call the API (comma separated). Leave unset for local development only.
# ALLOWED_ORIGINS=https://your-app.example.com
# Keeps wallet sign-ins valid across restarts. Use any long random string.
# SESSION_SECRET=
